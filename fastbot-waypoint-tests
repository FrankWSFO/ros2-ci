RUN mkdir -p /fastbot_ws/src \
    && cd /fastbot_ws/src \
    && git clone -b test https://github.com/FrankWSFO/docker-basics-for-robotics-project.git \
    && git clone -b for-jenkins-humble https://github.com/FrankWSFO/ros2-the-construct-testing-project.git

COPY ./fastbot /fastbot_ws/src/fastbot/
WORKDIR /fastbot_ws/src
RUN mv ./ros2-the-construct-testing-project /fastbot_ws/src/fastbot_waypoints/
RUN mv ./docker-basics-for-robotics-project/simulation/modified_botbox_world_room.launch.xml /fastbot_ws/src/fastbot/fastbot_gazebo/launch/botbox_world_room.launch.xml
RUn mv ./docker-basics-for-robotics-project/simulation/modified_fastbot_description_package.xml /fastbot_ws/src/fastbot/fastbot_description/package.xml
RUN mv ./docker-basics-for-robotics-project/simulation/modified_one_fastbot_room.launch.py /fastbot_ws/src/fastbot/fastbot_gazebo/launch/one_fastbot_room.launch.py
RUN mv ./docker-basics-for-robotics-project/simulation/fastbot_description_model.config /fastbot_ws/src/fastbot/fastbot_description/model.config
RUN mv ./docker-basics-for-robotics-project/simulation/modified_spawn_fastbot.launch.xml /fastbot_ws/src/fastbot/fastbot_gazebo/launch/spawn_fastbot.launch.xml

# Build the Colcon workspace and ensure it's sourced
RUN source /opt/ros/humble/setup.bash \
    && cd /fastbot_ws \
    && colcon build \
    && source /fastbot_ws/install/setup.bash
# RUN source /opt/ros/galactic/setup.bash \
#     && cd /fastbot_ws \
#     && colcon build \
#     && source /fastbot_ws/install/setup.bash
RUN echo "source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash" >> ~/.bashrc
# RUN echo "source /opt/ros/galactic/setup.bash && source /fastbot_ws/install/setup.bash" >> ~/.bashrc

# Set environment variables
ENV ROS_DOMAIN_ID=1
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Set the working folder at startup
WORKDIR /fastbot_ws

# ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /usr/share/gazebo/setup.sh && source /fastbot_ws/install/setup.bash && ros2 launch fastbot_gazebo one_fastbot_room.launch.py & \
#     source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash && ros2 run fastbot_waypoints fastbot_action_server & \
#     source /opt/ros/humble/setup.bash && source /fastbot_ws/install/setup.bash && colcon test --packages-select fastbot_waypoints --event-handler=console_direct+ && colcon test-result --all & \
#     tail -f /dev/null"]
COPY ./ros2_ci/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]


